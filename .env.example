# =================================================================
# MASTERED SKILL ACADEMY (MSA) HR APP - ENVIRONMENT VARIABLES
# =================================================================

# Application Server Port & Environment
PORT=5000
NODE_ENV=production
APP_URL=http://localhost:3000

# Security Secrets (Must be unique & random in production)
# JWT Secret for signing session tokens
JWT_SECRET=msa_hr_jwt_super_secret_key_change_in_production_2026_xyz

# 32-byte (64 hex characters) AES-256-GCM encryption key for Aadhaar/Bank details
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google Cloud Service Account Credentials (Sheets v4 & Drive v3 API)
# The client_email from your service account JSON key file
GOOGLE_SERVICE_ACCOUNT_EMAIL=msa-hr-service-account@msa-hr-project.iam.gserviceaccount.com

# The private_key from your service account JSON key file (include \n or raw multi-line)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...==\n-----END PRIVATE KEY-----\n"

# Google Spreadsheet ID (from the URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SPREADSHEET_ID=1a2b3c4d5e6f7g8h9i0j_your_google_spreadsheet_id_here

# Google Drive Root Folder ID (from the URL: https://drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_FOLDER_ID=1a2b3c4d5e6f7g8h9i0j_your_google_drive_folder_id_here

# Initial 3 Seed Accounts Passwords (Used only during `npm run setup`)
SEED_HR_MANAGER_EMAIL=hrmanager@masteredskill.com
SEED_HR_MANAGER_PASSWORD=MsaManager@2026#

SEED_HR_EXEC_EMAIL=hrexec@masteredskill.com
SEED_HR_EXEC_PASSWORD=MsaExec@2026#

SEED_EMPLOYEE_EMAIL=employee@masteredskill.com
SEED_EMPLOYEE_PASSWORD=MsaStaff@2026#

# Optional SMTP Email Service (for candidate notifications & alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hr@masteredskill.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Mastered Skill Academy HR <hr@masteredskill.com>"
